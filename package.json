{
  "name": "lattice-protocol-mvp",
  "version": "0.1.0",
  "description": "Lattice LNP/1 OS-native VPN control plane and migration tooling",
  "main": "dist/index.js",
  "bin": {
    "latticectl": "bin/latticectl.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run --dir tests",
    "build": "tsc",
    "build:native": "cmake -S daemon -B build/daemon && cmake --build build/daemon",
    "test:rust": "cargo test --manifest-path clients/rust/Cargo.toml",
    "test:network": "cargo test --manifest-path network/Cargo.toml --workspace",
    "build:network": "cargo build --manifest-path network/Cargo.toml --workspace",
    "migrate:network": "ts-node scripts/migrate-network-state.ts",
    "test:native": "npm run build:native && LATTICED_BIN=\"$PWD/build/daemon/latticed\" cargo test --manifest-path clients/rust/Cargo.toml",
    "test:replay-redis": "LATTICE_REDIS_INTEGRATION=1 vitest run tests/redis-replay.integration.test.ts",
    "lattice": "ts-node cli/lattice.ts",
    "package:bundle": "sh scripts/build-release-bundle.sh",
    "prepack": "node scripts/clean-dist.js && npm run build",
    "build:contracts": "solcjs --optimize --optimize-runs 200 --bin --abi --include-path contracts --base-path . -o contracts contracts/LatticeChain.sol"
  },
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "dependencies": {
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@types/chalk": "^0.4.31",
    "@types/http-proxy": "^1.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/ws": "^8.18.1",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "ethers": "^6.16.0",
    "http-proxy": "^1.18.1",
    "js-yaml": "^4.1.0",
    "solc": "^0.8.35",
    "ws": "^8.20.0",
    "zod": "^3.22.0"
  }
}
