[Unit]
Description=Lattice private DNS resolver for profile %i
After=lattice-netd@%i.service
BindsTo=lattice-netd@%i.service

[Service]
Type=simple
User=lattice
Group=lattice
EnvironmentFile=/etc/lattice/profiles/%i.env
ExecStart=/usr/local/bin/lattice-resolver --bind 127.0.0.1:5353 --profile /var/lib/lattice/profiles/%i/bundle.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
ReadOnlyPaths=/var/lib/lattice/profiles/%i

[Install]
WantedBy=multi-user.target

