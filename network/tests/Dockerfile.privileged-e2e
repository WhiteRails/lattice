# This image is deliberately built without any Lattice profile, key, offer, or
# host mount. It is used only as an ephemeral Linux namespace/TUN E2E runner.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH=/opt/cargo/bin:${PATH}

RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        dnsutils \
        iproute2 \
        iputils-ping \
        jq \
        libssl-dev \
        nftables \
        openssl \
        pkg-config \
        python3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal

WORKDIR /workspace/network
COPY . /workspace/network
RUN CARGO_INCREMENTAL=0 cargo build --locked --bins

CMD ["bash"]
